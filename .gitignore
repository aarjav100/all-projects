# ============================================================
#  COMPREHENSIVE .gitignore  —  Mixed Projects Workspace
#  Covers: Node.js, React, Next.js, Python, Android, IDEs
# ============================================================


# ─── Dependencies ───────────────────────────────────────────
node_modules/
bower_components/
jspm_packages/
vendor/


# ─── Build Outputs ──────────────────────────────────────────
dist/
build/
out/
.output/
.next/
.nuxt/
.vite/
.svelte-kit/
*.tsbuildinfo
*.js.map
*.css.map


# ─── Environment & Secrets ──────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging
.env*.local
*.pem
*.key
*.cert
*.p12
*.pfx
secrets.json
secrets.yaml
secrets.yml
config/secrets.*
.secret
credentials.json
service-account.json
firebase-adminsdk*.json


# ─── Logs ───────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*


# ─── Package Manager Caches / Lock Files (optional) ─────────
.npm/
.yarn/
.pnp/
.pnp.js
.cache/
.parcel-cache/


# ─── Runtime & Temp Files ───────────────────────────────────
*.pid
*.seed
*.pid.lock
tmp/
temp/
.tmp/
.temp/


# ─── Coverage & Testing ─────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
__pycache__/
*.py[cod]
*.pyo
.tox/
test-results/
junit.xml


# ─── Python ─────────────────────────────────────────────────
*.pyc
*.pyd
*.pyo
*.egg
*.egg-info/
dist/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
.venv/
venv/
env/
ENV/
.Python
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
Pipfile.lock


# ─── Android ────────────────────────────────────────────────
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
local.properties
.gradle/
captures/
.externalNativeBuild/
.cxx/
*.iml
proguard/


# ─── IDEs & Editors ─────────────────────────────────────────
# VS Code
.vscode/
!.vscode/extensions.json

# IntelliJ / Android Studio
.idea/
*.iws
*.ipr

# Eclipse
.classpath
.project
.settings/
.factorypath

# NetBeans
nbproject/private/
nbbuild/
nbdist/
nbactions.xml
nb-configuration.xml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim / Emacs
*.swp
*.swo
*~
\#*\#
.\#*
*.bak
*.orig


# ─── OS Generated Files ─────────────────────────────────────
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
*.stackdump

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems

# Linux
*~


# ─── Database & Storage ─────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.sql
dump.rdb
*.bak


# ─── Large / Binary Files ───────────────────────────────────
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
*.gz
*.iso
*.dmg
*.exe
*.msi
*.dll
*.so
*.dylib


# ─── Media (generated / large assets) ───────────────────────
*.mp4
*.mov
*.avi
*.mkv
*.wmv
*.flv
# Uncomment below if you don't want to track large images:
# *.psd
# *.ai
# *.sketch


# ─── AI / ML ────────────────────────────────────────────────
*.h5
*.hdf5
*.pkl
*.pickle
*.joblib
*.npy
*.npz
*.onnx
*.pt
*.pth
*.safetensors
*.bin
models/
checkpoints/
runs/
wandb/
mlruns/
.ipynb_checkpoints/


# ─── Docker ─────────────────────────────────────────────────
.dockerignore
docker-compose.override.yml


# ─── Firebase ───────────────────────────────────────────────
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
database-debug.log


# ─── Vercel / Netlify / Deployment ──────────────────────────
.vercel/
.netlify/


# ─── Misc ───────────────────────────────────────────────────
.DS_Store
*.local
.history/
.terraform/
*.tfstate
*.tfstate.backup
.serverless/
